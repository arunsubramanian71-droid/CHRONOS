<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.chronos</groupId><artifactId>chronos-parent</artifactId><version>0.2.0</version></parent>
  <artifactId>chronos-bench</artifactId>
  <name>chronos-bench</name>
  <description>Benchmarks and stress harnesses (C18): JMH micro-benchmarks, the whole-system timing harness, the chaos soak, and the build-time rule checks (banned-API scan NFR-20, dependency direction NFR-13). May depend on every module.</description>
  <properties><jmh.version>1.37</jmh.version></properties>
  <dependencies>
    <dependency><groupId>dev.chronos</groupId><artifactId>chronos-analysis</artifactId></dependency>
    <dependency><groupId>dev.chronos</groupId><artifactId>chronos-runtime</artifactId></dependency>
    <dependency><groupId>dev.chronos</groupId><artifactId>chronos-store</artifactId></dependency>
    <dependency><groupId>dev.chronos</groupId><artifactId>chronos-demo</artifactId></dependency>
    <dependency><groupId>dev.chronos</groupId><artifactId>chronos-sdk</artifactId></dependency>
    <dependency><groupId>dev.chronos</groupId><artifactId>chronos-model</artifactId></dependency>
    <dependency><groupId>dev.chronos</groupId><artifactId>chronos-cli</artifactId></dependency>
    <!-- JMH: build-time benchmarking only (D-20); the annotation processor generates the benchmark harness -->
    <dependency><groupId>org.openjdk.jmh</groupId><artifactId>jmh-core</artifactId><version>${jmh.version}</version></dependency>
    <dependency><groupId>org.openjdk.jmh</groupId><artifactId>jmh-generator-annprocess</artifactId><version>${jmh.version}</version><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path><groupId>org.openjdk.jmh</groupId><artifactId>jmh-generator-annprocess</artifactId><version>${jmh.version}</version></path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>chronos-bench</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>chronos.bench.BenchMain</mainClass></transformer>
              </transformers>
              <filters>
                <filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude><exclude>META-INF/versions/**</exclude></excludes></filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
